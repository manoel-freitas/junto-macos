{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Junto",
  "version": "0.1.0",
  "identifier": "com.manoelfreitas.junto",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "popover",
        "title": "Junto",
        "width": 320,
        "height": 420,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "transparent": true,
        "shadow": true,
        "skipTaskbar": true,
        "alwaysOnTop": false
      },
      {
        "label": "ju",
        "title": "Ju",
        "width": 128,
        "height": 128,
        "visible": true,
        "decorations": false,
        "resizable": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": false,
        "url": "pet.html"
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/32x32.png", "icons/128x128.png"],
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "12.0"
    }
  }
}